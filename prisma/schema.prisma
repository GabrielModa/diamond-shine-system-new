model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String?
  name            String?
  role            UserRole        @default(viewer)
  status          String          @default("pending")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supplyRequests  SupplyRequest[]
  feedbackEntries FeedbackEntry[] @relation("FeedbackSubmitter")
  receivedFeedback FeedbackEntry[] @relation("FeedbackEmployee")
  auditLogs       AuditLog[]      @relation("AuditActor")
  authTokens      AuthToken[]

  @@map("users")
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuthRateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  attempts  Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("auth_rate_limits")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  targetType String
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorEmail], references: [email])

  @@index([actorEmail])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("email_templates")
}

model NotificationSetting {
  id         String   @id @default(cuid())
  key        String   @unique
  recipients String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@map("notification_settings")
}

model SupplyRequest {
  id             String         @id @default(cuid())
  employeeName   String
  clientLocation String
  priority       SupplyPriority
  products       String
  notes          String?
  status         String         @default("Requested")
  submittedBy    String
  emailSentAt    DateTime?
  completedAt    DateTime?
  dueAt          DateTime?
  assignedTo     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [submittedBy], references: [email])
  items          SupplyRequestItem[]
  statusEvents   SupplyStatusEvent[]

  @@index([status])
  @@index([submittedBy])
  @@index([createdAt])
  @@map("supply_requests")
}

model FeedbackEntry {
  id              String           @id @default(cuid())
  employeeName    String
  employeeId      String?
  clientLocation  String
  cleanliness     Float
  punctuality     Float
  equipment       Float
  clientRelations Float
  overall         Float
  category        String
  comments        String?
  submittedBy     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation("FeedbackSubmitter", fields: [submittedBy], references: [email])
  employee        User?            @relation("FeedbackEmployee", fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([submittedBy])
  @@index([employeeName])
  @@index([employeeId])
  @@index([createdAt])
  @@map("feedback_entries")
}

enum UserRole {
  admin
  supervisor
  employee
  viewer
}

enum SupplyPriority {
  urgent
  normal
  low
}

model SupplyStatusEvent {
  id          String        @id @default(cuid())
  requestId   String
  fromStatus  String?
  toStatus    String
  actorEmail  String
  note        String?
  createdAt   DateTime      @default(now())
  request     SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("supply_status_events")
}

model SupplyRequestItem {
  id        String        @id @default(cuid())
  requestId String
  product   String
  quantity  Int
  request   SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("supply_request_items")
}

enum AuthTokenType {
  invite
  password_reset
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
