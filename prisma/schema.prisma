model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String?
  name            String?
  role            UserRole        @default(viewer)
  status          String          @default("pending")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  supplyRequests  SupplyRequest[]
  feedbackEntries FeedbackEntry[] @relation("FeedbackSubmitter")
  receivedFeedback FeedbackEntry[] @relation("FeedbackEmployee")
  auditLogs       AuditLog[]      @relation("AuditActor")
  authTokens      AuthToken[]
  memberships     Membership[]

  @@map("users")
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  timezone             String                @default("Europe/Dublin")
  status               OrganizationStatus    @default(active)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  memberships          Membership[]
  capabilityGrants     CapabilityGrant[]
  supplyRequests       SupplyRequest[]
  feedbackEntries      FeedbackEntry[]
  auditLogs            AuditLog[]
  emailTemplates       EmailTemplate[]
  notificationSettings NotificationSetting[]
  notificationJobs     NotificationJob[]
  authTokens           AuthToken[]

  @@map("organizations")
}

model Membership {
  id               String           @id @default(cuid())
  organizationId   String
  userId           String
  role             MembershipRole
  status           MembershipStatus @default(active)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  capabilityGrants CapabilityGrant[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role, status])
  @@map("memberships")
}

model CapabilityGrant {
  id             String       @id @default(cuid())
  organizationId String
  membershipId   String
  capability     String
  scopeType      ScopeType    @default(organization)
  scopeId        String       @default("")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, capability, scopeType, scopeId])
  @@index([organizationId, capability, scopeType, scopeId])
  @@map("capability_grants")
}

model AuthToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      AuthTokenType
  userId    String
  organizationId String @default("org_legacy_diamond_shine")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, type])
  @@index([organizationId, type])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AuthRateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  attempts  Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("auth_rate_limits")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorEmail String
  action     String
  targetType String
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now())
  actor      User     @relation("AuditActor", fields: [actorEmail], references: [email])
  organizationId String @default("org_legacy_diamond_shine")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([actorEmail])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String
  subject   String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  organizationId String @default("org_legacy_diamond_shine")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("email_templates")
}

model NotificationSetting {
  id         String   @id @default(cuid())
  key        String
  recipients String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  organizationId String @default("org_legacy_diamond_shine")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("notification_settings")
}

model SupplyRequest {
  id             String         @id @default(cuid())
  employeeName   String
  clientLocation String
  priority       SupplyPriority
  products       String
  notes          String?
  status         String         @default("Requested")
  submittedBy    String
  emailSentAt    DateTime?
  completedAt    DateTime?
  dueAt          DateTime?
  assignedTo     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [submittedBy], references: [email])
  items          SupplyRequestItem[]
  statusEvents   SupplyStatusEvent[]
  organizationId String @default("org_legacy_diamond_shine")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([status])
  @@index([submittedBy])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("supply_requests")
}

model FeedbackEntry {
  id              String           @id @default(cuid())
  employeeName    String
  employeeId      String?
  clientLocation  String
  cleanliness     Float
  punctuality     Float
  equipment       Float
  clientRelations Float
  overall         Float
  category        String
  comments        String?
  submittedBy     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation("FeedbackSubmitter", fields: [submittedBy], references: [email])
  employee        User?            @relation("FeedbackEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  organizationId  String @default("org_legacy_diamond_shine")
  organization    Organization     @relation(fields: [organizationId], references: [id])

  @@index([submittedBy])
  @@index([employeeName])
  @@index([employeeId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("feedback_entries")
}

enum UserRole {
  admin
  supervisor
  employee
  viewer
}

enum SupplyPriority {
  urgent
  normal
  low
}

model NotificationJob {
  id            String   @id @default(cuid())
  kind          String
  status        String   @default("queued")
  payload       Json
  entityType    String?
  entityId      String?
  createdBy     String
  attempts      Int      @default(0)
  maxAttempts   Int      @default(5)
  nextAttemptAt DateTime @default(now())
  lastAttemptAt DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organizationId String @default("org_legacy_diamond_shine")
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([status, nextAttemptAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([organizationId, status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("notification_jobs")
}

model SupplyStatusEvent {
  id          String        @id @default(cuid())
  requestId   String
  fromStatus  String?
  toStatus    String
  actorEmail  String
  note        String?
  createdAt   DateTime      @default(now())
  request     SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("supply_status_events")
}

model SupplyRequestItem {
  id        String        @id @default(cuid())
  requestId String
  product   String
  quantity  Int
  request   SupplyRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("supply_request_items")
}

enum AuthTokenType {
  invite
  password_reset
}

enum OrganizationStatus {
  active
  suspended
  archived
}

enum MembershipRole {
  organization_admin
  field_supervisor
  scheduler
  employee
  stock_controller
  quality_inspector
  finance
  viewer
}

enum MembershipStatus {
  invited
  active
  suspended
  removed
}

enum ScopeType {
  organization
  region
  contract
  site
  self
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
